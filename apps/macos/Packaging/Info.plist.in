<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>@DISPLAY_NAME@</string>
    <key>CFBundleExecutable</key>
    <string>Nodavo</string>
    <key>CFBundleIdentifier</key>
    <string>dev.nodavo.macos</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ru</string>
    </array>
    <key>CFBundleName</key>
    <string>Nodavo</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@BUILD_NUMBER@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSBonjourServices</key>
    <array>
        <string>_nodavo._udp</string>
    </array>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Nodavo discovers and connects to explicitly paired devices on your local network.</string>
    <key>NodavoAgentBundleIdentifier</key>
    <string>dev.nodavo.agent</string>
    <key>NodavoAgentMachService</key>
    <string>dev.nodavo.agent.ipc</string>
    <key>NodavoAppleTeamIdentifier</key>
    <string>@TEAM_ID@</string>
    <key>NodavoDevelopmentBuild</key>
    <@DEVELOPMENT_BOOL@/>
</dict>
</plist>
