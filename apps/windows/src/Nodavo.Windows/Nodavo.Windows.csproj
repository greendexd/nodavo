<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Nodavo.Windows</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <NodavoPackageMode Condition="'$(NodavoPackageMode)' == ''">Packaged</NodavoPackageMode>
    <WindowsPackageType Condition="'$(NodavoPackageMode)' == 'Unpackaged'">None</WindowsPackageType>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.3916" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Nodavo.AgentServerAuth.Mode</_Parameter1>
      <_Parameter2>$(NodavoAgentServerAuthMode)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Nodavo.AgentServerAuth.PackageNameBase64</_Parameter1>
      <_Parameter2>$(NodavoAgentServerAuthPackageNameBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Nodavo.AgentServerAuth.PublisherBase64</_Parameter1>
      <_Parameter2>$(NodavoAgentServerAuthPublisherBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Nodavo.AgentServerAuth.PackageFamilyNameBase64</_Parameter1>
      <_Parameter2>$(NodavoAgentServerAuthPackageFamilyNameBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Nodavo.AgentServerAuth.ApplicationUserModelIdBase64</_Parameter1>
      <_Parameter2>$(NodavoAgentServerAuthApplicationUserModelIdBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Nodavo.AgentServerAuth.RelativeExecutableBase64</_Parameter1>
      <_Parameter2>$(NodavoAgentServerAuthRelativeExecutableBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Nodavo.AgentServerAuth.SignerCertificateSha256</_Parameter1>
      <_Parameter2>$(NodavoAgentServerAuthSignerCertificateSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
