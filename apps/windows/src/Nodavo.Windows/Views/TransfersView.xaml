<UserControl
    x:Class="Nodavo.Windows.Views.TransfersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon FontSize="44" Glyph="&#xE896;" />
            <TextBlock x:Uid="TransfersTitle" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Uid="TransfersUnavailable" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            <InfoBar x:Uid="UnavailableBadge" IsClosable="False" IsOpen="True" Severity="Informational" />
        </StackPanel>
    </Grid>
</UserControl>
