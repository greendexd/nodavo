<UserControl
    x:Class="Nodavo.Windows.Views.LayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center" Spacing="14">
                <FontIcon FontSize="44" Glyph="&#xECA5;" />
                <TextBlock
                    x:Uid="LayoutTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="LayoutSubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="RefreshLayoutButton"
                        x:Uid="LayoutRefresh"
                        Click="RefreshLayoutButton_Click" />
                    <ProgressRing
                        x:Name="LayoutProgress"
                        Width="24"
                        Height="24"
                        IsActive="False"
                        Visibility="Collapsed" />
                </StackPanel>
                <InfoBar
                    x:Name="LayoutStatus"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <ComboBox
                    x:Name="PeerSelector"
                    x:Uid="LayoutPeerSelector"
                    DisplayMemberPath="DisplayText"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="PeerSelector_SelectionChanged" />

                <Border
                    x:Name="LayoutDetails"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="SelectedPeerName" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SelectedPeerState"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Uid="LayoutCurrentPlacementLabel" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentPlacementText" TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="PlacementSelector"
                            x:Uid="LayoutPlacementSelector"
                            DisplayMemberPath="Label"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="PlacementSelector_SelectionChanged" />
                        <Button
                            x:Name="ApplyPlacementButton"
                            x:Uid="LayoutApplyPlacement"
                            Click="ApplyPlacementButton_Click"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            x:Uid="LayoutPlacementHelp"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Uid="LayoutPreAlpha"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
