<UserControl
    x:Class="Nodavo.Windows.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="680" HorizontalAlignment="Center" Spacing="14">
                <FontIcon FontSize="44" Glyph="&#xE770;" />
                <TextBlock
                    x:Uid="DevicesTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="DevicesSubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Uid="TrustedDevicesHeading"
                    FontWeight="SemiBold"
                    Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="RefreshTrustedButton"
                        x:Uid="TrustedDevicesRefresh"
                        Click="RefreshTrustedButton_Click" />
                    <ProgressRing
                        x:Name="TrustedDevicesProgress"
                        Width="24"
                        Height="24"
                        IsActive="False"
                        Visibility="Collapsed" />
                </StackPanel>
                <InfoBar
                    x:Name="TrustedDevicesStatus"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />
                <ListView
                    x:Name="TrustedPeersList"
                    MaxHeight="180"
                    SelectionChanged="TrustedPeersList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border
                    x:Name="TrustedPeerDetails"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="TrustedPeerName" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="TrustedPeerState" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch
                            x:Name="TrustedInputGrant"
                            x:Uid="TrustedAllowInput"
                            Toggled="TrustedGrant_Toggled" />
                        <ToggleSwitch
                            x:Name="TrustedClipboardReadGrant"
                            x:Uid="TrustedAllowClipboardRead"
                            Toggled="TrustedGrant_Toggled" />
                        <ToggleSwitch
                            x:Name="TrustedClipboardWriteGrant"
                            x:Uid="TrustedAllowClipboardWrite"
                            Toggled="TrustedGrant_Toggled" />
                        <ToggleSwitch
                            x:Name="TrustedFilesGrant"
                            x:Uid="TrustedAllowFiles"
                            Toggled="TrustedGrant_Toggled" />
                        <TextBlock
                            x:Uid="TrustedPermissionsHelp"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="RevokePeerButton"
                            x:Uid="TrustedRevoke"
                            Click="RevokePeerButton_Click"
                            HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Uid="PairingHeading"
                    FontWeight="SemiBold"
                    Margin="0,18,0,0" />

                <InfoBar
                    x:Name="PairingStatus"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <Button
                    x:Name="ListenButton"
                    x:Uid="PairingListen"
                    HorizontalAlignment="Stretch"
                    Click="ListenButton_Click" />

                <TextBox
                    x:Name="EndpointBox"
                    x:Uid="PairingEndpoint"
                    MaxLength="512" />
                <Button
                    x:Name="ConnectButton"
                    x:Uid="PairingConnect"
                    HorizontalAlignment="Stretch"
                    Click="ConnectButton_Click" />

                <TextBlock
                    x:Uid="PairingPermissionsHeading"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0" />
                <CheckBox x:Name="InputPermission" x:Uid="PairingAllowInput" />
                <CheckBox x:Name="ClipboardReadPermission" x:Uid="PairingAllowClipboardRead" />
                <CheckBox x:Name="ClipboardWritePermission" x:Uid="PairingAllowClipboardWrite" />
                <CheckBox x:Name="FilesPermission" x:Uid="PairingAllowFiles" />
                <TextBlock
                    x:Uid="PairingPermissionsHelp"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <StackPanel
                    x:Name="BusyPanel"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="Collapsed">
                    <ProgressRing Width="24" Height="24" IsActive="True" />
                    <TextBlock
                        x:Name="BusyText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border
                    x:Name="CodePanel"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="PairingPeerLabel" FontWeight="SemiBold" />
                        <TextBlock x:Name="PeerNameText" TextWrapping="Wrap" />
                        <TextBlock x:Uid="PairingCodeLabel" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="CodeText"
                            FontFamily="Consolas"
                            FontSize="38"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            CharacterSpacing="160" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button
                                x:Name="ConfirmButton"
                                x:Uid="PairingConfirm"
                                Click="ConfirmButton_Click" />
                            <Button
                                x:Name="DeclineButton"
                                x:Uid="PairingCancel"
                                Click="CancelButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button
                    x:Name="WaitingCancelButton"
                    x:Uid="PairingCancel"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"
                    Visibility="Collapsed" />

                <InfoBar
                    x:Uid="PairingPreAlpha"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
