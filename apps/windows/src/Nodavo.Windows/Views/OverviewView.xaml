<UserControl
    x:Class="Nodavo.Windows.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="32" Spacing="20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="OverviewTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="OverviewSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="28" Glyph="{Binding StatusGlyph}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="ConnectionHeading" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnSpacing="24" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="PeerLabel" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding PeerText}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="InputOwnerLabel" Grid.Row="1" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InputOwnerText}" />
                        <TextBlock x:Uid="FocusLabel" Grid.Row="2" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FocusStateText}" TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Uid="FocusAcquireButton"
                                IsEnabled="{Binding CanRequestRemoteFocus}"
                                Click="FocusAcquireButton_Click" />
                            <Button
                                x:Uid="FocusReleaseButton"
                                IsEnabled="{Binding CanReleaseFocus}"
                                Click="FocusReleaseButton_Click" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{Binding IsFocusOperationInProgress}" />
                        </StackPanel>
                        <TextBlock
                            Text="{Binding FocusGuidanceText}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="ReadinessHeading" FontWeight="SemiBold" />
                        <TextBlock x:Uid="ReadinessSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="24" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="AgentReachabilityLabel" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding AgentReachabilityText}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="InputEnvironmentLabel" Grid.Row="1" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding InputEnvironmentText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InputEnvironmentGuidanceText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Uid="LocalDisplaysLabel" Grid.Row="2" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LocalDisplaysText}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="PeerTopologyLabel" Grid.Row="3" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PeerTopologyText}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="AgentLifecycleHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Lifecycle.AgentStateText, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Lifecycle.AgentRecoveryText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Uid="StartAgentButton"
                            IsEnabled="{x:Bind Lifecycle.CanStartAgent, Mode=OneWay}"
                            Click="StartAgentButton_Click" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind Lifecycle.IsLifecycleOperationInProgress, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Uid="RefreshButton" Click="RefreshButton_Click" />
                <Button x:Uid="EmergencyStopButton" Click="EmergencyStopButton_Click" />
            </StackPanel>

            <InfoBar
                x:Uid="PreAlphaNotice"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
